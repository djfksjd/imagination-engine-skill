{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djfksjd/imagination-engine-skill/candidate.schema.json",
  "title": "imagination-engine candidate",
  "description": "The structure score_gate.py validates, together with draw.json, banlist.json and the markdown that will be shown. Length floors here are halved relative to the gate's own minimums, because the gate counts units (a CJK letter counts as two) and a plain minLength cannot.",
  "type": "object",
  "required": [
    "topic",
    "run",
    "modes",
    "anchor",
    "sections",
    "broken_rule",
    "domains_used",
    "perspective_id",
    "sense_seed_id",
    "affect_pair_id",
    "resembles",
    "scores",
    "weakest_fix"
  ],
  "additionalProperties": true,
  "properties": {
    "topic": {
      "type": "string"
    },
    "run": {
      "type": "integer",
      "minimum": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anchor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "sections": {
      "type": "object",
      "required": [
        "name",
        "one_line",
        "principle",
        "first_encounter",
        "strangest_property",
        "affect",
        "world_effect",
        "avoided"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Checked for being a placeholder rather than for length; score_gate.py is authoritative."
        },
        "one_line": {
          "type": "string",
          "minLength": 30
        },
        "principle": {
          "type": "string",
          "minLength": 100
        },
        "first_encounter": {
          "type": "string",
          "minLength": 150
        },
        "strangest_property": {
          "type": "string",
          "minLength": 75
        },
        "affect": {
          "type": "string",
          "minLength": 60
        },
        "world_effect": {
          "type": "string",
          "minLength": 100
        },
        "avoided": {
          "type": "string",
          "minLength": 75
        },
        "operational_path": {
          "type": "string",
          "minLength": 100,
          "description": "Required in grounded mode: one path to something real, and the part of the principle that does not survive it."
        }
      },
      "description": "Length floors here are halved relative to score_gate.py's own minimums, because the gate counts units (a CJK letter counts as two) and a plain minLength cannot. A generic JSON Schema validator must not reject a candidate the gate accepts."
    },
    "broken_rule": {
      "type": "object",
      "required": [
        "constraint_ids",
        "how_each_is_broken",
        "new_law",
        "now_impossible"
      ],
      "description": "Extremal mode draws two constraints. A single constraint_id could only account for one of them, so the second was silently dropped.",
      "properties": {
        "constraint_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Exact set of ids drawn in decks/constraints.json for this run."
        },
        "how_each_is_broken": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "explanation"
            ],
            "properties": {
              "constraint_id": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "minLength": 15
              }
            }
          },
          "description": "One entry per drawn constraint. A single replacement law may cover all of them, but none may go unaccounted for."
        },
        "new_law": {
          "type": "string",
          "minLength": 15
        },
        "now_impossible": {
          "type": "string",
          "minLength": 15,
          "description": "what the new law forbids that the old world allowed"
        }
      }
    },
    "domains_used": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "answer_to_probe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "id from decks/domains.json"
          },
          "answer_to_probe": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "invented_sense": {
      "type": "object",
      "description": "Required when affect mode is active.",
      "required": [
        "detects",
        "mechanism",
        "consequence",
        "cost"
      ],
      "properties": {
        "detects": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        }
      }
    },
    "resembles": {
      "type": "array",
      "minItems": 1,
      "description": "Nearest known works, named honestly. If nothing close was found, say what you checked.",
      "items": {
        "type": "object",
        "required": [
          "work",
          "how_it_differs"
        ],
        "properties": {
          "work": {
            "type": "string"
          },
          "how_it_differs": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "score",
          "justification"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "justification": {
            "type": "string",
            "minLength": 40
          }
        }
      },
      "properties": {
        "translation_integrity": {
          "type": "object",
          "description": "Scored instead of non_anthropocentrism when score_gate.py is run with --grounded.",
          "required": [
            "score",
            "justification"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "justification": {
              "type": "string",
              "minLength": 40
            }
          }
        }
      },
      "description": "Which axes are required depends on the run: grounded substitutes translation_integrity for non_anthropocentrism. score_gate.py derives that from the validated draw, which plain JSON Schema cannot express - so no axis is listed as unconditionally required here."
    },
    "weakest_fix": {
      "type": "string",
      "minLength": 40,
      "description": "the weakest axis and what a rewrite would change"
    },
    "perspective_id": {
      "type": "string",
      "minLength": 1,
      "description": "id from decks/perspectives.json, must equal the drawn one"
    },
    "sense_seed_id": {
      "type": "string",
      "minLength": 1,
      "description": "id from decks/senses.json, must equal the drawn one"
    },
    "affect_pair_id": {
      "type": "string",
      "minLength": 1,
      "description": "id from decks/affects.json, must equal the drawn one"
    },
    "manual_checks_cleared": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 15
      },
      "description": "One written answer per manual check in banlist.json. A check that is only printed is not a check."
    }
  }
}
