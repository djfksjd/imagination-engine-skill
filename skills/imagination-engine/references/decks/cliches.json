  "structural_patterns": [
    { "id": "x-meets-y", "regex": "\\b[A-Za-z]+\\s+meets\\s+[A-Za-z]+\\b", "tier": "ban", "why": "The pitch reduces to two known things joined by a verb. If the idea survives this sentence, it is a combination, not an invention." },
    { "id": "cross-between", "regex": "\\bcross between\\b", "tier": "ban", "why": "Same failure as X meets Y, stated more honestly." },
    { "id": "mix-of-a-and-b", "regex": "\\b(a )?(mix|blend|fusion|mashup) of\\b", "tier": "ban", "why": "Announces assembly. The parts should have stopped being separable." },
    { "id": "but-with-ai", "regex": "\\bbut with (AI|robots|magic|aliens|blockchain)\\b", "tier": "ban", "why": "An ordinary thing with a topical noun attached." },
    { "id": "ai-powered", "regex": "\\b(AI|smart|quantum|holographic|nano|cyber|neuro)[- ]powered\\b", "tier": "ban", "why": "A prefix is doing the work the idea should do." },
    { "id": "it-is-like", "regex": "\\bit'?s (basically |essentially |kind of )?like\\b", "tier": "warn", "why": "The description is leaning on a reference instead of on its own principle." },
    { "id": "in-the-future", "regex": "\\bin the (near |far |distant )?future\\b", "tier": "warn", "why": "Setting the clock forward is not a premise change." },
    { "id": "year-stamp", "regex": "\\b(the year )?2[01]\\d{2}\\b", "tier": "warn", "why": "A date is being used as a substitute for a different world." },
    { "id": "imagine-a", "regex": "\\bimagine (a|an|if)\\b", "tier": "warn", "why": "Pitch filler. Start with the thing itself." }
  ],
  "moves": [
    "Attaching a modern buzzword to an ordinary object and calling the result new.",
    "Changing only size, color, material, or scale.",
    "Combining two adjacent concepts from the same field.",
    "Reskinning an existing famous work with new proper nouns.",
    "Making a being strange in appearance while its motives stay human and legible.",
    "Explaining the weirdness away with a technology that could be swapped for any other technology.",
    "Strangeness that exists only in the visual description and changes nothing about how the thing works.",
    "A twist that the reader can name before it arrives.",
    "Random incoherence presented as depth: rules that contradict each other with no accounting.",
    "Designing the thing around a human benefit and then decorating it as alien.",
    "Naming an ordinary concept with an invented word and treating the word as the invention."
  ]
}
